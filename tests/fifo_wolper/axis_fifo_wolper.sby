# AXI Stream FIFO: Wolper checker (wolper) and, for comparison, the UF checker
# (uf) and a traditional shadow-queue scoreboard (sb). prove_wolper:
# k-induction of the Wolper checker with auxiliary invariants
# (tb_axis_fifo_wolper_formal_inv.psl).
#
# Parameters: the D, W line in both pycode blocks (the tests and compare.py
# replace it in a copy). BMC depth 2*D+6: filling takes D cycles and draining
# D+1 cycles after reset, so the horizon covers a full FIFO, every slot
# written and read and wrapped pointers. prove depth PROVE_K.
[tasks]
wolper       bmc
uf           bmc
sb           bmc
prove_wolper prove

[options]
bmc: mode bmc
prove: mode prove
--pycode-begin--
D, W = 4, 8
PROVE_K = 2
output("depth %d" % (PROVE_K if "prove" in tags else 2 * D + 6))
--pycode-end--

[engines]
smtbmc bitwuzla

[script]
plugin -i ghdl
--pycode-begin--
D, W = 4, 8
g = "ghdl --std=08 -gDEPTH=%d -gWIDTH=%d axis_fifo.vhdl tb_axis_ctrl_formal.vhdl " % (D, W)
if "wolper" in tags:
    output(g + "tb_axis_fifo_wolper_formal.vhdl -e tb_axis_fifo_wolper_formal")
    output("prep -top tb_axis_fifo_wolper_formal")
if "prove" in tags:
    output(g + "tb_axis_fifo_wolper_formal.vhdl tb_axis_fifo_wolper_formal_inv.psl -e tb_axis_fifo_wolper_formal")
    output("prep -top tb_axis_fifo_wolper_formal")
if "uf" in tags:
    output(g + "tb_axis_stim_formal.vhdl tb_axis_fifo_uf_formal.vhdl -e tb_axis_fifo_uf_formal")
    output("prep -top tb_axis_fifo_uf_formal")
if "sb" in tags:
    output(g + "tb_axis_fifo_sb_formal.vhdl -e tb_axis_fifo_sb_formal")
    output("prep -top tb_axis_fifo_sb_formal")
# Memories to registers: bit-level registers solve faster than the array theory.
output("memory_map")
output("opt -fast")
if "uf" in tags:
    output("select -assert-count 2 */a:uf_instance=stim_f")
else:
    output("select -assert-none */a:uf_instance")
if "prove" in tags:
    # Probes p_* to internal DUT signals (see inv.psl). Flatten first so that
    # dut.* is in the same module. Guard: the anyseq cells (4 probes) are gone.
    output("flatten")
    output("cd tb_axis_fifo_wolper_formal")
    output("select -assert-count 4 t:$anyseq")
    output("connect -set tb_axis_fifo_wolper_formal_inv.p_count dut.count")
    output("connect -set tb_axis_fifo_wolper_formal_inv.p_rd dut.rd")
    output("connect -set tb_axis_fifo_wolper_formal_inv.p_wr dut.wr")
    for j in range(D):
        output("connect -set tb_axis_fifo_wolper_formal_inv.p_mem[%d:%d] dut.mem[%d]" % (j * W + W - 1, j * W, j))
    output("opt_clean")
    output("select -assert-none t:$anyseq")
    output("cd ..")
--pycode-end--

[files]
axis_fifo.vhdl
tb_axis_ctrl_formal.vhdl
tb_axis_stim_formal.vhdl
tb_axis_fifo_wolper_formal.vhdl
tb_axis_fifo_wolper_formal_inv.psl
tb_axis_fifo_uf_formal.vhdl
tb_axis_fifo_sb_formal.vhdl

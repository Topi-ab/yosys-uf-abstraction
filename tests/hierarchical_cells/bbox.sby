[tasks]
pass       ok   bv
fail       bad  bv
pass_stbv  ok   stbv
pass_stdt  ok   stdt

[options]
mode bmc
depth 3

[engines]
bv:   smtbmc bitwuzla
stbv: smtbmc --stbv yices
stdt: smtbmc --stdt z3

[script]
ok:  read_verilog -formal -sv bbox.sv
bad: read_verilog -formal -sv -DBAD bbox.sv
prep -top top

[files]
bbox.sv

FROM ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
      libreadline8t64 tcl zlib1g libgmp10 libmpfr6 libffi8 libstdc++6 libgnat-13 \
      python3 python3-click python3-pytest python3-pytest-xdist make ca-certificates \
 && rm -rf /var/lib/apt/lists/*
COPY ext/_install /opt/toolchain
# GHDL_PREFIX: GHDL finds its standard libraries here even if the toolchain was built
# with a different install prefix and copied into /opt/toolchain.
ENV PATH=/opt/toolchain/bin:$PATH \
    LD_LIBRARY_PATH=/opt/toolchain/lib \
    GHDL_PREFIX=/opt/toolchain/lib/ghdl
WORKDIR /work
